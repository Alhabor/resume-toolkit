{
  "name": "resume-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Local, portable, AI-friendly resume source and PDF build system.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "init": "node scripts/init.mjs",
    "build:duplex": "node scripts/build-duplex.mjs",
    "build:example": "node scripts/build.mjs --input examples/resume.example.json --output dist/example",
    "check:example": "node scripts/check.mjs --input examples/resume.example.json --pdf dist/example.pdf",
    "build:example:zh": "node scripts/build.mjs --input examples/resume.example.zh.json --output dist/example-zh",
    "check:example:zh": "node scripts/check.mjs --input examples/resume.example.zh.json --pdf dist/example-zh.pdf",
    "smoke": "npm run build:example && npm run check:example && npm run build:example:zh && npm run check:example:zh"
  },
  "devDependencies": {
    "@jsonresume/schema": "^1.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
